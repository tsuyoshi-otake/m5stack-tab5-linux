# Stamp-P4 M1 kernel configuration fragment.
#
# The ESP32-P4 architecture and UART/CLIC/SYSTIMER symbols are supplied by
# the reviewed P4 baseline patch set. Buildroot's olddefconfig must run after
# those patches are applied; this file is not a claim that unpatched upstream
# Linux already contains these symbols.
CONFIG_32BIT=y
# CONFIG_64BIT is not set
CONFIG_RISCV=y
CONFIG_ARCH_ESPRESSIF=y
CONFIG_SOC_ESP32P4=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_M_MODE=y
CONFIG_MMU=n
CONFIG_SMP=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_NONSTANDARD_CACHE_OPS=y
CONFIG_PAGE_OFFSET=0x48000000
CONFIG_ARCH_FLATMEM_ENABLE=y

# Built-in command line is the fallback only.  The boot-shim copies the
# flashed DTB and Linux reads /chosen/bootargs from it; measured 2026-08-15
# on the 0014 Image, /proc/device-tree/chosen/bootargs carried a DTB-only
# module parameter that /proc/cmdline discarded because FORCE was set.
# FORCE=y is therefore not a missing-handoff guard anymore: it hides the
# DTB command line.  Keep the built-in string so a missing DTB bootargs
# still reaches a rootfs; do not force it over a present one.
CONFIG_CMDLINE="earlycon=esp32p4usbjtag,mmio32,0x500d2000 keep_bootcon loglevel=8 root=/dev/mtdblock0 rootfstype=squashfs ro init=/sbin/init idle=poll"
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FALLBACK=y

CONFIG_ESP32P4_CLIC=y
CONFIG_ESP32P4_SYSTIMER=y
CONFIG_SERIAL_ESP32=y
# Keep UART0 as a tty for a future fixture, but do not register it as the
# kernel console: the only currently visible capture path is USB-JTAG
# earlycon, and registering ttyS0 retires that path after driver probe.
# CONFIG_SERIAL_ESP32_CONSOLE is not set

CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_FLAT_NO_DATA_START_OFFSET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_RESERVED_MEM=y

CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y

CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_PANIC_TIMEOUT=5

# M1 recovery watchdog; the driver is part of the reviewed P4 patch series.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ESP32P4_WDT=y

# Commit the /boot image to flash without a reboot (patch 0072).
CONFIG_ESP32P4_BOOTFLASH=y

# Deep Sleep through the boot shim (patch 0093, #56).
CONFIG_ESP32P4_SLEEP=y

# Explicit M1 non-goals.
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# No framebuffer/VT is needed for the headless bring-up.  Leaving VT_CONSOLE
# enabled would install tty0 and retire the USB-JTAG early console before the
# init scripts can report SDIO/SSH state.
CONFIG_EXPERT=y
# CONFIG_VT is not set
# CONFIG_VT_CONSOLE is not set

# --- Tab5 display profile additions --------------------------------------
# The M1 headless image deliberately disabled VT entirely.  Tab5 keeps the
# same USB-JTAG/ACM console but also wants kernel text on the ST7121/ST7123
# panel through the simple-framebuffer node that the boot shim patches in
# once the DSI stream is running (linux/dts/esp32p4-tab5.dts).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# fbcon=rotate:3 turns the console 90 deg CCW for the landscape dock
# orientation; the fb geometry stays the panel's native 720x1280.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FONT_SUPPORT=y
# 8x16 on the 720x1280 panel is 90 x 80 cells, too small to read.  Terminus
# 16x32 gives 45 x 40.  fbcon picks its default font by .pref (8x16 = 0,
# TER16x32 = -1 on RISC-V), so the bootargs name it: fbcon=font:TER16x32.
# FONTS=y turns off the implicit default fonts, so 8x16 stays explicit as
# the fallback.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

NOT STAGED.  Candidate kernel patch for the Tab5 framebuffer console.
=====================================================================

Why it exists
-------------
The Tab5 boot shim brings the ST7123 panel up on MIPI-DSI and leaves the
DPI/DW-GDMA stream reading a PSRAM framebuffer that the
simple-framebuffer DTB node exposes as /dev/fb0 (see
linux/dts/esp32p4-tab5.dts).  P4 PSRAM accesses are cached; GDMA reads
the physical memory directly.  Without a writeback after each cfb
operation the panel shows whatever the cache has not yet evicted -- a
stale or torn console.

The DTS marks the node `espressif,flush-cache`.  This patch teaches
drivers/video/fbdev/simplefb.c to wrap the cfb ops with a
dma_sync_single_for_device writeback when that property is present, the
same non-coherent sync primitive the dw-mmc IDMAC patches (0012/0013)
already rely on.

Status
------
Candidate only.  Context below is written against the upstream
simplefb.c shape (FB_DEFAULT_SYS_OPS era) and has NOT been applied or
compiled against the locked 7.2.11 tree.  Stage it into
linux/kernel-patches/ only after `patch --dry-run` succeeds in the
Docker build tree; if the context fails, rebase the two hunks by hand --
they are small on purpose.

--- a/drivers/video/fbdev/simplefb.c
+++ b/drivers/video/fbdev/simplefb.c
@@ -xx,6 +xx,33 @@
 #include <linux/platform_device.h>
 #include <linux/property.h>
 
+/*
+ * espressif,flush-cache: the framebuffer memory is read by a DMA
+ * master (Tab5's DPI/DW-GDMA stream handed over from the boot shim)
+ * that does not snoop the CPU data cache.  Write back after every cfb
+ * operation so console output reaches the panel.
+ */
+static void simplefb_flush_cache(struct fb_info *info)
+{
+	dma_sync_single_for_device(info->device, info->fix.smem_start,
+				   info->fix.smem_len, DMA_TO_DEVICE);
+}
+
+static void simplefb_fillrect_flush(struct fb_info *info, const struct fb_fillrect *rect)
+{
+	cfb_fillrect(info, rect);
+	simplefb_flush_cache(info);
+}
+
+static void simplefb_copyarea_flush(struct fb_info *info, const struct fb_copyarea *area)
+{
+	cfb_copyarea(info, area);
+	simplefb_flush_cache(info);
+}
+
+static void simplefb_imageblit_flush(struct fb_info *info, const struct fb_image *image)
+{
+	cfb_imageblit(info, image);
+	simplefb_flush_cache(info);
+}
+
 static const struct fb_ops simplefb_ops = {
 	.owner		= THIS_MODULE,
 	.fb_destroy	= simplefb_destroy,
@@ -xx,6 +xx,17 @@
 	.fb_ioctl	= simplefb_ioctl,
 };
 
+static const struct fb_ops simplefb_flush_ops = {
+	.owner		= THIS_MODULE,
+	.fb_destroy	= simplefb_destroy,
+	.fb_read	= fb_sys_read,
+	.fb_write	= fb_sys_write,
+	.fb_setcolreg	= simplefb_setcolreg,
+	.fb_set_par	= simplefb_set_par,
+	.fb_ioctl	= simplefb_ioctl,
+	.fb_fillrect	= simplefb_fillrect_flush,
+	.fb_copyarea	= simplefb_copyarea_flush,
+	.fb_imageblit	= simplefb_imageblit_flush,
+};
+
 /*
  * Helpers
  */
@@ -xx,7 +xx,10 @@
 	}
 
 	info->fbops = &simplefb_ops;
+	if (of_property_read_bool(pdev->dev.of_node, "espressif,flush-cache"))
+		info->fbops = &simplefb_flush_ops;
 	info->flags = FBINFO_DEFAULT | FBINFO_MISC_FIRMWARE;
 	info->screen_base = ioremap_wc(mem->start, resource_size(mem));
 	info->screen_size = resource_size(mem);

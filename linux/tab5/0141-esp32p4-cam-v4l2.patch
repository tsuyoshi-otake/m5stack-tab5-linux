+static ssize_t cam_read(struct file *f, char __user *buf, size_t cnt,
+			loff_t *pos)
+{
+	struct esp32p4_cam *c =
+		container_of(f->private_data, struct esp32p4_cam, misc);
+	ssize_t ret;

@@ -0,0 +1,530 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * M5Stack Tab5 Keyboard (A164) I2C driver.
+ *
+ * The unit is an STM32F030C8T6 matrix scanner behind Tab5's Ext.Port1
+ * header: I2C slave at 0x6d on the dedicated hw GPIO0 (SDA) / GPIO1
+ * (SCL) pair -- a bus of its own, independent of the bit-banged
+ * internal bus on GPIO31/32.  Its key-ready interrupt is hw GPIO50 on
+ * gpio bank 1, which the esp32p4 gpio driver does not wire to an
+ * irq_chip, so events are polled from the chip FIFO at 40 Hz; the
+ * queue holds events until drained, so polling loses nothing.
+ *
+ * Wire protocol (m5stack M5Tab5-Keyboard-Internal-FW, MIT licensed):
+ *
+ *   0x00  INT_CFG    bit0/1/2 = key/hid/char event enables
+ *   0x01  INT_STA    pending event types; write 0 clears + releases INT
+ *   0x02  EVENT_NUM  queued event count; write 0 flushes the FIFO
+ *   0x03  BRIGHTNESS overall level of the two indicator LEDs
+ *   0x10  KB_MODE    0=key, 1=hid, 2=char
+ *   0x30  HID_EVENT  pops one entry per read: [modifier, usage];
+ *                    usage == 0 marks a release, 0xff/0xff means empty
+ *   0xfe  VERSION    firmware byte
+ *
+ * HID mode is used because the MCU already owns the Aa/Sym layer
+ * state machine: each press event is a complete (modifier, usage)
+ * pair and each release is (modifier, 0).  The zero-usage release
+ * does not name a key, so on release every tracked non-modifier
+ * usage is dropped and modifiers are re-synced from the byte -- a
+ * self-healing model when several keys span a release.
+ *
+ * The MCU's two RGB LEDs stay in their default "binding" mode
+ * (key-state feedback handled on the chip), so no led device is
+ * registered here.
+ *
+ * Presence tracking: the unit can be attached after boot, and its
+ * MCU resets to a non-HID, LEDs-on state whenever its power drops.
+ * The driver therefore registers the input device unconditionally
+ * and lets the poll work own the attach/detach state machine:
+ *
+ *   absent:  once a second, read VERSION; a unit that answers gets
+ *            the configure sequence (HID mode, FIFO flush, interrupt
+ *            enables, LED brightness) and moves to present.
+ *   present: the usual 25 ms drain; eight consecutive I/O failures
+ *            mean the unit is gone, so every tracked key is released
+ *            (a detached keyboard can never report a release) and the
+ *            driver returns to absent.  Once a second, and after any
+ *            I/O error streak, KB_MODE is read back: a unit that
+ *            silently reset still answers I2C but comes up
+ *            unconfigured, so the configure sequence is replayed.
+ *
+ * The STM32 runs its I2C pins with no pull and the stock design
+ * relies on the host's internal pad pull-ups (the ESP-IDF demo sets
+ * enable_internal_pullup).  i2c-gpio only toggles direction, so the
+ * probe enables WPU on the two IO_MUX pads itself; the pad indices
+ * are fixed by the board wiring (hw GPIO0 = SDA, hw GPIO1 = SCL).
+ */
+
+#include <linux/bitmap.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/workqueue.h>
+
+#define TAB5KBD_REG_INT_CFG	0x00
+#define TAB5KBD_REG_INT_STA	0x01
+#define TAB5KBD_REG_EVENT_NUM	0x02
+#define TAB5KBD_REG_BRIGHTNESS	0x03
+#define TAB5KBD_REG_KB_MODE	0x10
+#define TAB5KBD_REG_HID_EVENT	0x30
+#define TAB5KBD_REG_VERSION	0xfe
+
+#define TAB5KBD_CFG_HID_EN	0x02
+#define TAB5KBD_STA_HID		0x02
+#define TAB5KBD_MODE_HID	0x01
+
+#define TAB5KBD_MOD_FIRST	0xe0	/* HID usages e0..e7 = modifiers */
+#define TAB5KBD_USAGE_MAX	0xe8
+#define TAB5KBD_DRAIN_MAX	32
+#define TAB5KBD_POLL_MS		25
+#define TAB5KBD_PROBE_MS	1000	/* absent: ask for the MCU once a second */
+#define TAB5KBD_ERR_MAX		8	/* I/O failures that mean detached */
+#define TAB5KBD_MODE_CHECK_POLLS 40	/* ~1 s between KB_MODE checks */
+
+#define TAB5KBD_IOMUX_BASE	0x500e1000
+#define TAB5KBD_IOMUX_PIN(n)	(0x4 + (n) * 0x4)
+#define TAB5KBD_IOMUX_WPU	BIT(8)
+#define TAB5KBD_IOMUX_IE	BIT(9)
+
+struct tab5kbd {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct delayed_work work;
+	DECLARE_BITMAP(pressed, TAB5KBD_USAGE_MAX);
+	bool present;
+	bool absence_reported;
+	unsigned int io_errors;
+	unsigned int polls_since_check;
+	u8 brightness;
+	bool have_brightness;
+};
+
+/* HID usage -> Linux keycode for the 0x04..0x67 range (0 = unmapped). */
+static const u16 tab5kbd_keycode[0x68] = {
+	[0x04] = KEY_A,		[0x05] = KEY_B,		[0x06] = KEY_C,
+	[0x07] = KEY_D,		[0x08] = KEY_E,		[0x09] = KEY_F,
+	[0x0a] = KEY_G,		[0x0b] = KEY_H,		[0x0c] = KEY_I,
+	[0x0d] = KEY_J,		[0x0e] = KEY_K,		[0x0f] = KEY_L,
+	[0x10] = KEY_M,		[0x11] = KEY_N,		[0x12] = KEY_O,
+	[0x13] = KEY_P,		[0x14] = KEY_Q,		[0x15] = KEY_R,
+	[0x16] = KEY_S,		[0x17] = KEY_T,		[0x18] = KEY_U,
+	[0x19] = KEY_V,		[0x1a] = KEY_W,		[0x1b] = KEY_X,
+	[0x1c] = KEY_Y,		[0x1d] = KEY_Z,
+	[0x1e] = KEY_1,		[0x1f] = KEY_2,		[0x20] = KEY_3,
+	[0x21] = KEY_4,		[0x22] = KEY_5,		[0x23] = KEY_6,
+	[0x24] = KEY_7,		[0x25] = KEY_8,		[0x26] = KEY_9,
+	[0x27] = KEY_0,
+	[0x28] = KEY_ENTER,	[0x29] = KEY_ESC,	[0x2a] = KEY_BACKSPACE,
+	[0x2b] = KEY_TAB,	[0x2c] = KEY_SPACE,	[0x2d] = KEY_MINUS,
+	[0x2e] = KEY_EQUAL,	[0x2f] = KEY_LEFTBRACE,	[0x30] = KEY_RIGHTBRACE,
+	[0x31] = KEY_BACKSLASH,	[0x32] = KEY_BACKSLASH,	[0x33] = KEY_SEMICOLON,
+	[0x34] = KEY_APOSTROPHE,[0x35] = KEY_GRAVE,	[0x36] = KEY_COMMA,
+	[0x37] = KEY_DOT,	[0x38] = KEY_SLASH,	[0x39] = KEY_CAPSLOCK,
+	[0x3a] = KEY_F1,	[0x3b] = KEY_F2,	[0x3c] = KEY_F3,
+	[0x3d] = KEY_F4,	[0x3e] = KEY_F5,	[0x3f] = KEY_F6,
+	[0x40] = KEY_F7,	[0x41] = KEY_F8,	[0x42] = KEY_F9,
+	[0x43] = KEY_F10,	[0x44] = KEY_F11,	[0x45] = KEY_F12,
+	[0x46] = KEY_SYSRQ,	[0x47] = KEY_SCROLLLOCK,	[0x48] = KEY_PAUSE,
+	[0x49] = KEY_INSERT,	[0x4a] = KEY_HOME,	[0x4b] = KEY_PAGEUP,
+	[0x4c] = KEY_DELETE,	[0x4d] = KEY_END,	[0x4e] = KEY_PAGEDOWN,
+	[0x4f] = KEY_RIGHT,	[0x50] = KEY_LEFT,	[0x51] = KEY_DOWN,
+	[0x52] = KEY_UP,
+	[0x53] = KEY_NUMLOCK,	[0x54] = KEY_KPSLASH,	[0x55] = KEY_KPASTERISK,
+	[0x56] = KEY_KPMINUS,	[0x57] = KEY_KPPLUS,	[0x58] = KEY_KPENTER,
+	[0x59] = KEY_KP1,	[0x5a] = KEY_KP2,	[0x5b] = KEY_KP3,
+	[0x5c] = KEY_KP4,	[0x5d] = KEY_KP5,	[0x5e] = KEY_KP6,
+	[0x5f] = KEY_KP7,	[0x60] = KEY_KP8,	[0x61] = KEY_KP9,
+	[0x62] = KEY_KP0,	[0x63] = KEY_KPDOT,
+	[0x64] = KEY_102ND,	[0x65] = KEY_COMPOSE,	[0x66] = KEY_POWER,
+	[0x67] = KEY_KPEQUAL,
+};
+
+/* HID usages e0..e7 reported in the modifier byte. */
+static const u16 tab5kbd_modifier_keycode[8] = {
+	KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_LEFTALT, KEY_LEFTMETA,
+	KEY_RIGHTCTRL, KEY_RIGHTSHIFT, KEY_RIGHTALT, KEY_RIGHTMETA,
+};
+
+static u16 tab5kbd_code(u8 usage)
+{
+	if (usage >= TAB5KBD_MOD_FIRST && usage < TAB5KBD_USAGE_MAX)
+		return tab5kbd_modifier_keycode[usage - TAB5KBD_MOD_FIRST];
+	if (usage < ARRAY_SIZE(tab5kbd_keycode))
+		return tab5kbd_keycode[usage];
+	return 0;
+}
+
+/*
+ * Enable the host-side pad pull-ups the keyboard's bus design
+ * expects.  Must run before the first transaction on the bus.
+ */
+static void tab5kbd_pull_up_pads(struct device *dev)
+{
+	static const u8 pads[2] = { 0, 1 }; /* hw GPIO0 SDA, GPIO1 SCL */
+	void __iomem *iomux;
+	int i;
+
+	iomux = devm_ioremap(dev, TAB5KBD_IOMUX_BASE, 0x100);
+	if (!iomux) {
+		dev_warn(dev, "iomux map failed; bus relies on stray pulls\n");
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(pads); i++) {
+		u32 v = readl(iomux + TAB5KBD_IOMUX_PIN(pads[i]));
+
+		writel(v | TAB5KBD_IOMUX_WPU | TAB5KBD_IOMUX_IE,
+		       iomux + TAB5KBD_IOMUX_PIN(pads[i]));
+	}
+}
+
+static int tab5kbd_read(struct i2c_client *client, u8 reg,
+			u8 *data, u8 len)
+{
+	struct i2c_msg msgs[] = {
+		{
+			.addr = client->addr,
+			.flags = 0,
+			.len = 1,
+			.buf = &reg,
+		}, {
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = len,
+			.buf = data,
+		},
+	};
+
+	if (i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs)) !=
+	    ARRAY_SIZE(msgs))
+		return -EIO;
+	return 0;
+}
+
+static int tab5kbd_write(struct i2c_client *client, u8 reg, u8 val)
+{
+	u8 buf[2] = { reg, val };
+
+	return i2c_master_send(client, buf, sizeof(buf)) == sizeof(buf) ?
+	       0 : -EIO;
+}
+
+/* Bring the reported modifier keys in line with the modifier byte. */
+static void tab5kbd_sync_modifiers(struct tab5kbd *kbd, u8 modifier)
+{
+	struct input_dev *input = kbd->input;
+	unsigned int i;
+
+	for (i = 0; i < 8; i++) {
+		unsigned int mod = TAB5KBD_MOD_FIRST + i;
+
+		if (modifier & BIT(i)) {
+			if (!test_and_set_bit(mod, kbd->pressed)) {
+				input_event(input, EV_MSC, MSC_SCAN, mod);
+				input_report_key(input,
+						 tab5kbd_modifier_keycode[i], 1);
+			}
+		} else if (test_and_clear_bit(mod, kbd->pressed)) {
+			input_event(input, EV_MSC, MSC_SCAN, mod);
+			input_report_key(input,
+					 tab5kbd_modifier_keycode[i], 0);
+		}
+	}
+}
+
+static void tab5kbd_event(struct tab5kbd *kbd, u8 modifier, u8 usage)
+{
+	struct input_dev *input = kbd->input;
+	unsigned long bit;
+
+	if (usage) {
+		u16 code = tab5kbd_code(usage);
+
+		/*
+		 * Modifiers go first.  The MCU sends its symbol keys as a
+		 * shifted usage ('!' is LeftShift + '1'), so Shift must be
+		 * down before the key, and a Shift left over from the
+		 * previous symbol must be up before a plain key.
+		 */
+		tab5kbd_sync_modifiers(kbd, modifier);
+		if (code && !test_and_set_bit(usage, kbd->pressed)) {
+			input_event(input, EV_MSC, MSC_SCAN, usage);
+			input_report_key(input, code, 1);
+		}
+		return;
+	}
+
+	/*
+	 * A zero usage is a bare release with no key identity: drop
+	 * every tracked non-modifier usage first, then re-sync the
+	 * modifiers to what the byte still reports as held.
+	 */
+	for_each_set_bit(bit, kbd->pressed, TAB5KBD_MOD_FIRST) {
+		input_event(input, EV_MSC, MSC_SCAN, bit);
+		input_report_key(input, tab5kbd_keycode[bit], 0);
+	}
+	bitmap_clear(kbd->pressed, 0, TAB5KBD_MOD_FIRST);
+	tab5kbd_sync_modifiers(kbd, modifier);
+}
+
+/*
+ * Drop every tracked usage and modifier: a detached keyboard can
+ * never report the releases, so nothing may be left held.
+ */
+static void tab5kbd_release_all(struct tab5kbd *kbd)
+{
+	struct input_dev *input = kbd->input;
+	unsigned long bit;
+
+	for_each_set_bit(bit, kbd->pressed, TAB5KBD_USAGE_MAX) {
+		input_event(input, EV_MSC, MSC_SCAN, bit);
+		input_report_key(input, tab5kbd_code(bit), 0);
+	}
+	bitmap_clear(kbd->pressed, 0, TAB5KBD_USAGE_MAX);
+	input_sync(input);
+}
+
+/*
+ * Push the whole MCU setup: HID mode, FIFO flushed, hid events
+ * enabled, status cleared so INT drops, then the DT-requested
+ * indicator brightness.  Idempotent -- called on probe and on every
+ * re-attach, because a power-cycled MCU comes back unconfigured.
+ */
+static int tab5kbd_configure(struct tab5kbd *kbd)
+{
+	struct i2c_client *client = kbd->client;
+	int error;
+
+	error = tab5kbd_write(client, TAB5KBD_REG_KB_MODE,
+			      TAB5KBD_MODE_HID);
+	if (!error)
+		error = tab5kbd_write(client, TAB5KBD_REG_EVENT_NUM, 0);
+	if (!error)
+		error = tab5kbd_write(client, TAB5KBD_REG_INT_CFG,
+				      TAB5KBD_CFG_HID_EN);
+	if (!error)
+		error = tab5kbd_write(client, TAB5KBD_REG_INT_STA, 0);
+	if (!error && kbd->have_brightness)
+		error = tab5kbd_write(client, TAB5KBD_REG_BRIGHTNESS,
+				      kbd->brightness);
+	return error;
+}
+
+/* Returns true once a unit answered and accepted the configuration. */
+static bool tab5kbd_try_attach(struct tab5kbd *kbd)
+{
+	u8 version = 0;
+
+	if (tab5kbd_read(kbd->client, TAB5KBD_REG_VERSION, &version, 1) < 0)
+		return false;
+	if (tab5kbd_configure(kbd) < 0)
+		return false;
+
+	kbd->present = true;
+	kbd->absence_reported = false;
+	kbd->io_errors = 0;
+	kbd->input->id.version = version;
+	dev_info(&kbd->client->dev,
+		 "tab5-keyboard: attached, fw 0x%02x, polling at %d Hz\n",
+		 version, 1000 / TAB5KBD_POLL_MS);
+	return true;
+}
+
+static int tab5kbd_drain(struct tab5kbd *kbd)
+{
+	struct i2c_client *client = kbd->client;
+	u8 sta[2], ev[2];
+	unsigned int i;
+	int error = 0;
+
+	/* 0x01 reads [INT_STA, EVENT_NUM] in one transaction. */
+	if (tab5kbd_read(client, TAB5KBD_REG_INT_STA, sta, sizeof(sta)) < 0)
+		return -EIO;
+	if (!(sta[0] & TAB5KBD_STA_HID) || !sta[1])
+		return 0;
+	if (sta[1] > TAB5KBD_DRAIN_MAX)
+		sta[1] = TAB5KBD_DRAIN_MAX;
+	for (i = 0; i < sta[1]; i++) {
+		if (tab5kbd_read(client, TAB5KBD_REG_HID_EVENT, ev,
+				 sizeof(ev)) < 0) {
+			error = -EIO;
+			break;
+		}
+		if (ev[0] == 0xff && ev[1] == 0xff)
+			break;
+		tab5kbd_event(kbd, ev[0], ev[1]);
+	}
+	/* Clears pending bits and releases the INT line. */
+	if (tab5kbd_write(client, TAB5KBD_REG_INT_STA, 0) < 0)
+		error = -EIO;
+	input_sync(kbd->input);
+	return error;
+}
+
+/*
+ * A reset MCU keeps answering I2C while dropping every setting, so a
+ * working link alone does not prove the unit still runs the
+ * configured mode -- it comes back in raw key mode, LEDs on and no
+ * HID notifications, which looks exactly like an idle keyboard.  When
+ * KB_MODE has drifted, drop held keys and replay the configure
+ * sequence.  Runs about once a second while attached and on the first
+ * successful transaction after an I/O error streak.
+ */
+static int tab5kbd_check_mode(struct tab5kbd *kbd)
+{
+	u8 mode = 0;
+
+	if (tab5kbd_read(kbd->client, TAB5KBD_REG_KB_MODE, &mode, 1) < 0)
+		return -EIO;
+	if (mode == TAB5KBD_MODE_HID)
+		return 0;
+	dev_warn(&kbd->client->dev,
+		 "tab5-keyboard: MCU dropped to mode %u, reconfiguring\n",
+		 mode);
+	tab5kbd_release_all(kbd);
+	return tab5kbd_configure(kbd) < 0 ? -EIO : 0;
+}
+
+static void tab5kbd_poll(struct work_struct *work)
+{
+	struct tab5kbd *kbd = container_of(to_delayed_work(work),
+					   struct tab5kbd, work);
+	unsigned int delay;
+
+	if (!kbd->present) {
+		delay = TAB5KBD_PROBE_MS;
+		if (tab5kbd_try_attach(kbd)) {
+			delay = TAB5KBD_POLL_MS;
+		} else if (!kbd->absence_reported) {
+			kbd->absence_reported = true;
+			dev_info(&kbd->client->dev,
+				 "tab5-keyboard: absent, watching for attach\n");
+		}
+	} else {
+		bool check = kbd->io_errors != 0 ||
+			++kbd->polls_since_check >= TAB5KBD_MODE_CHECK_POLLS;
+
+		delay = TAB5KBD_POLL_MS;
+		if (tab5kbd_drain(kbd) < 0) {
+			if (++kbd->io_errors >= TAB5KBD_ERR_MAX) {
+				kbd->present = false;
+				kbd->io_errors = 0;
+				kbd->absence_reported = true;
+				tab5kbd_release_all(kbd);
+				dev_info(&kbd->client->dev,
+					 "tab5-keyboard: detached, watching for attach\n");
+				delay = TAB5KBD_PROBE_MS;
+			}
+		} else {
+			kbd->io_errors = 0;
+			if (check) {
+				kbd->polls_since_check = 0;
+				if (tab5kbd_check_mode(kbd) < 0)
+					kbd->io_errors = 1;
+			}
+		}
+	}
+	schedule_delayed_work(&kbd->work, msecs_to_jiffies(delay));
+}
+
+static int tab5kbd_probe(struct i2c_client *client)
+{
+	struct tab5kbd *kbd;
+	struct input_dev *input;
+	u32 brightness;
+	int error, i;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(&client->dev, -ENXIO,
+				     "adapter lacks plain I2C\n");
+
+	tab5kbd_pull_up_pads(&client->dev);
+
+	kbd = devm_kzalloc(&client->dev, sizeof(*kbd), GFP_KERNEL);
+	if (!kbd)
+		return -ENOMEM;
+	kbd->client = client;
+	i2c_set_clientdata(client, kbd);
+	INIT_DELAYED_WORK(&kbd->work, tab5kbd_poll);
+
+	/*
+	 * Cached so a re-attach replays the board's LED brightness
+	 * request on the freshly powered MCU.
+	 */
+	if (!of_property_read_u32(client->dev.of_node,
+				  "m5stack,led-brightness", &brightness)) {
+		kbd->brightness = min_t(u32, brightness, 255);
+		kbd->have_brightness = true;
+	}
+
+	input = devm_input_allocate_device(&client->dev);
+	if (!input)
+		return -ENOMEM;
+	kbd->input = input;
+	input->name = "tab5-keyboard";
+	input->phys = "tab5-kbd/input0";
+	input->id.bustype = BUS_I2C;
+	input->id.vendor = 0x06d;
+	/* id.version is filled by tab5kbd_try_attach once a unit answers. */
+	input->dev.parent = &client->dev;
+	input_set_drvdata(input, kbd);
+
+	__set_bit(EV_KEY, input->evbit);
+	__set_bit(EV_REP, input->evbit);
+	input_set_capability(input, EV_MSC, MSC_SCAN);
+	for (i = 0; i < ARRAY_SIZE(tab5kbd_keycode); i++)
+		if (tab5kbd_keycode[i])
+			__set_bit(tab5kbd_keycode[i], input->keybit);
+	for (i = 0; i < 8; i++)
+		__set_bit(tab5kbd_modifier_keycode[i], input->keybit);
+
+	error = input_register_device(input);
+	if (error)
+		return dev_err_probe(&client->dev, error,
+				     "input device registration failed\n");
+
+	/*
+	 * The unit may not be attached at boot: the input device
+	 * registers regardless, and the poll work keeps asking for the
+	 * MCU until one answers, so a later attach works without a
+	 * manual rebind.
+	 */
+	if (!tab5kbd_try_attach(kbd)) {
+		kbd->absence_reported = true;
+		dev_info(&client->dev,
+			 "tab5-keyboard: absent, watching for attach\n");
+	}
+	schedule_delayed_work(&kbd->work,
+			      msecs_to_jiffies(kbd->present ?
+					       TAB5KBD_POLL_MS :
+					       TAB5KBD_PROBE_MS));
+	return 0;
+}
+
+static void tab5kbd_remove(struct i2c_client *client)
+{
+	struct tab5kbd *kbd = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&kbd->work);
+}
+
+static const struct of_device_id tab5kbd_of_match[] = {
+	{ .compatible = "m5stack,tab5-keyboard" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tab5kbd_of_match);
+
+static struct i2c_driver tab5kbd_driver = {
+	.driver = {
+		.name = "tab5-keyboard",
+		.of_match_table = tab5kbd_of_match,
+	},
+	.probe = tab5kbd_probe,
+	.remove = tab5kbd_remove,
+};
+module_i2c_driver(tab5kbd_driver);
+
+MODULE_AUTHOR("Devin <devin@cognition.ai>");
+MODULE_DESCRIPTION("M5Stack Tab5 Keyboard (A164) I2C driver");
+MODULE_LICENSE("GPL");

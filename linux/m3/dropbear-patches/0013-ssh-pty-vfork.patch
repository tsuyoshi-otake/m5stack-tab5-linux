# Subject: ssh: keep the PTY vfork child to plain syscalls (#53)
#
# ptycommand() ran the session command in a vfork() child that still
# did libc work in the shared address space: signal(SIGTTOU) inside
# pty_make_controlling_tty() wrote the shared uClibc sighandler table,
# chansess_login_alloc/login_login/login_free_entry did malloc + a
# utmp file write, and the DO_MOTD block did malloc/stat/read/write.
# Any one of those can corrupt state the parent still depends on
# before execve() returns, so the child has to be syscalls-only.
#
# The observed PTY failure was a chain, not a direct crash in the
# child.  Kernel instrumentation showed the parent dying inside
# free_child_envp's free() loop on an out-of-bounds element pointer
# (0012's m_free(*e++) double evaluation; 9448a76 in this branch).
# The dead parent's fd teardown then closed the ptmx master, the
# resulting pty_close -> vhangup sent SIGHUP+SIGCONT to the slave's
# session leader - the exec'ing child - and the fatal signal turned
# the flat loader's killable kernel_read into -EINTR, which printed
# "binfmt_flat: Unable to read code+data+bss" and tore the session
# down.  Whether child-side libc writes ever contributed to the
# parent's crash is unresolved [INF]: the fault reproduced while the
# child was pared to a direct execve, and the envp loop bug alone
# accounts for the exact faulting pointer (the next heap chunk's size
# word).  Noptycommand() survived the same bug only because its heap
# layout usually put a NULL after the envp array [INF].
#
# For DROPBEAR_VFORK the child is now syscalls-only: close(master),
# setsid(), TIOCSCTTY on the slave (the vfork-safe subset of
# pty_make_controlling_tty), dup2 to 0/1/2, a plain write() of the
# motd the parent read before vfork(), then execchild().  The utmp
# login record moves to the parent after vfork(), which also gives it
# the real child pid.  All child error paths end in _exit(127) - the
# old "return DROPBEAR_FAILURE" from a vfork child was itself a
# shared-stack corruption.  The !DROPBEAR_VFORK fork() path is
# unchanged.
#
--- a/src/svr-chansession.c
+++ b/src/svr-chansession.c
@@ -50,6 +50,11 @@
 static void execchild(const void *user_data_chansess);
 #if DROPBEAR_VFORK
 static char **svr_child_envp;
+#if DROPBEAR_VFORK && DO_MOTD
+/* Parent reads the motd before vfork(); the child just write()s it. */
+static char svr_child_motd[4096];
+static unsigned int svr_child_motd_len;
+#endif
 static char **build_child_envp(const struct ChanSess *chansess);
 static void free_child_envp(void);
 #endif
@@ -827,8 +832,7 @@
 
 	pid_t pid;
 	struct logininfo *li = NULL;
-#if DO_MOTD
